{
  "name": "ieee-psl-vhdl-formatter",
  "displayName": "IEEE PSL VHDL Formatter",
  "description": "Formatter for IEEE PSL (Property Specification Language) in VHDL flavor",
  "version": "1.0.0",
  "repository": {"url": "https://github.com/albydnc/ieee-psl-vhdl-formatter.git"},
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "psl",
        "aliases": [
          "PSL",
          "psl",
          "IEEE-PSL"
        ],
        "extensions": [
          ".psl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "psl",
        "scopeName": "source.psl",
        "path": "./syntaxes/psl.tmLanguage.json"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "IEEE PSL VHDL Formatter",
        "properties": {
          "pslVhdlFormatter.indentSize": {
            "type": "number",
            "default": 2,
            "description": "Number of spaces for indentation"
          },
          "pslVhdlFormatter.maxLineLength": {
            "type": "number",
            "default": 80,
            "description": "Maximum line length"
          },
          "pslVhdlFormatter.alignOperators": {
            "type": "boolean",
            "default": true,
            "description": "Align temporal operators"
          }
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "keyword.operator.temporal.psl",
            "settings": {
              "foreground": "#a5d6ff"
            }
          },
          {
            "scope": "comment.line.double-dash.psl",
            "settings": {
              "fontStyle": "italic"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}